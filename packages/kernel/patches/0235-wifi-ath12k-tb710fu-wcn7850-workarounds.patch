From: "lich.wang" <lich.wang@gmail.com>
Date: Fri, 23 Oct 2026 06:07:21 +0000
Subject: [PATCH] wifi: ath12k: TB710FU WCN7850 workarounds

From MeteoricmeteorLL/tb710fu-linux, reduced to what is active on the
running device and gated on lenovo,tb710fu:

- HTC/WMI service their copy-engine rings while waiting for the first
  responses and TX credits (the interrupts do not arrive then);
- no firmware log: it floods WMI_DIAG events during scans and starves
  WMI and the HTC credits;
- STA power save off at association with the related firmware
  parameters pinned: the host setting never reaches the firmware and
  buffered unicast came in ~2 s bursts;
- group frames: report the already stripped IV;
- hardware crypto: set the encrypt type of protected frames, which
  otherwise went out unencrypted.

A board_name module parameter forces the board-2.bin entry name, for
the vendor board file.  The periodic CE/DP poller and the tuning knobs
of the original port are left out: they are off on the running device.
---
 drivers/net/wireless/ath/ath12k/core.c        | 15 +++++++
 drivers/net/wireless/ath/ath12k/dp_htt.c      |  4 +-
 drivers/net/wireless/ath/ath12k/htc.c         | 41 +++++++++++++++++-
 drivers/net/wireless/ath/ath12k/htc.h         |  4 ++
 drivers/net/wireless/ath/ath12k/mac.c         | 28 +++++++++++++
 drivers/net/wireless/ath/ath12k/qmi.c         |  6 ++-
 drivers/net/wireless/ath/ath12k/wifi7/dp_rx.c |  9 +++-
 drivers/net/wireless/ath/ath12k/wifi7/dp_tx.c | 14 +++++++
 drivers/net/wireless/ath/ath12k/wmi.c         | 42 ++++++++++++++-----
 9 files changed, 147 insertions(+), 16 deletions(-)

diff --git a/drivers/net/wireless/ath/ath12k/core.c b/drivers/net/wireless/ath/ath12k/core.c
index 32d422ae2..d64b6275b 100644
--- a/drivers/net/wireless/ath/ath12k/core.c
+++ b/drivers/net/wireless/ath/ath12k/core.c
@@ -215,10 +215,25 @@ int ath12k_core_resume(struct ath12k_base *ab)
 }
 EXPORT_SYMBOL(ath12k_core_resume);
 
+/*
+ * TB710FU: the board-2.bin from the vendor firmware uses an entry name that
+ * the generated one does not match, so allow forcing it.
+ */
+static char *ath12k_board_name;
+module_param_named(board_name, ath12k_board_name, charp, 0644);
+MODULE_PARM_DESC(board_name, "Force the board-2.bin entry name (not used for the regdb lookup)");
+
 static int __ath12k_core_create_board_name(struct ath12k_base *ab, char *name,
 					   size_t name_len, bool with_variant,
 					   bool bus_type_mode, bool with_default)
 {
+	/* the regdb lookup (bus_type_mode, "bus=pci" only) must keep its name */
+	if (!bus_type_mode && ath12k_board_name && ath12k_board_name[0]) {
+		strscpy(name, ath12k_board_name, name_len);
+		ath12k_info(ab, "board name overridden: %s\n", name);
+		return 0;
+	}
+
 	/* strlen(',variant=') + strlen(ab->qmi.target.bdf_ext) */
 	char variant[9 + ATH12K_QMI_BDF_EXT_STR_LENGTH] = {};
 
diff --git a/drivers/net/wireless/ath/ath12k/dp_htt.c b/drivers/net/wireless/ath/ath12k/dp_htt.c
index 68968f96b..677f0f601 100644
--- a/drivers/net/wireless/ath/ath12k/dp_htt.c
+++ b/drivers/net/wireless/ath/ath12k/dp_htt.c
@@ -928,8 +928,8 @@ int ath12k_dp_tx_htt_h2t_ver_req_msg(struct ath12k_base *ab)
 		return ret;
 	}
 
-	ret = wait_for_completion_timeout(&dp->htt_tgt_version_received,
-					  HTT_TARGET_VERSION_TIMEOUT_HZ);
+	ret = ath12k_htc_poll_wait_completion(ab, &dp->htt_tgt_version_received,
+					      HTT_TARGET_VERSION_TIMEOUT_HZ);
 	if (ret == 0) {
 		ath12k_warn(ab, "htt target version request timed out\n");
 		return -ETIMEDOUT;
diff --git a/drivers/net/wireless/ath/ath12k/htc.c b/drivers/net/wireless/ath/ath12k/htc.c
index 92138caa2..532a25370 100644
--- a/drivers/net/wireless/ath/ath12k/htc.c
+++ b/drivers/net/wireless/ath/ath12k/htc.c
@@ -3,6 +3,7 @@
  * Copyright (c) 2018-2021 The Linux Foundation. All rights reserved.
  * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
  */
+#include <linux/of.h>
 #include <linux/skbuff.h>
 #include <linux/ctype.h>
 
@@ -555,6 +556,42 @@ int ath12k_htc_wait_target(struct ath12k_htc *htc)
 	return 0;
 }
 
+/*
+ * TB710FU: the WCN7850 copy-engine interrupts do not arrive while HTC/WMI
+ * wait for their first responses, so the waits below service the CE rings
+ * themselves.  Both callers run in process context; serialize them.
+ */
+static DEFINE_MUTEX(ath12k_htc_poll_lock);
+
+void ath12k_htc_poll_ce_all(struct ath12k_base *ab)
+{
+	int i;
+
+	mutex_lock(&ath12k_htc_poll_lock);
+	for (i = 0; i < ab->hw_params->ce_count; i++)
+		ath12k_ce_per_engine_service(ab, i);
+	mutex_unlock(&ath12k_htc_poll_lock);
+}
+
+unsigned long ath12k_htc_poll_wait_completion(struct ath12k_base *ab,
+					      struct completion *done,
+					      unsigned long timeout)
+{
+	unsigned long deadline = jiffies + timeout;
+
+	if (!of_machine_is_compatible("lenovo,tb710fu"))
+		return wait_for_completion_timeout(done, timeout);
+
+	do {
+		if (wait_for_completion_timeout(done, msecs_to_jiffies(5)))
+			return 1;
+
+		ath12k_htc_poll_ce_all(ab);
+	} while (time_before(jiffies, deadline));
+
+	return 0;
+}
+
 int ath12k_htc_connect_service(struct ath12k_htc *htc,
 			       struct ath12k_htc_svc_conn_req *conn_req,
 			       struct ath12k_htc_svc_conn_resp *conn_resp)
@@ -626,8 +663,8 @@ int ath12k_htc_connect_service(struct ath12k_htc *htc,
 	}
 
 	/* wait for response */
-	time_left = wait_for_completion_timeout(&htc->ctl_resp,
-						ATH12K_HTC_CONN_SVC_TIMEOUT_HZ);
+	time_left = ath12k_htc_poll_wait_completion(ab, &htc->ctl_resp,
+						    ATH12K_HTC_CONN_SVC_TIMEOUT_HZ);
 	if (!time_left) {
 		ath12k_err(ab, "Service connect timeout\n");
 		return -ETIMEDOUT;
diff --git a/drivers/net/wireless/ath/ath12k/htc.h b/drivers/net/wireless/ath/ath12k/htc.h
index 05b3e5935..9d6f240a3 100644
--- a/drivers/net/wireless/ath/ath12k/htc.h
+++ b/drivers/net/wireless/ath/ath12k/htc.h
@@ -304,6 +304,10 @@ struct ath12k_htc {
 int ath12k_htc_init(struct ath12k_base *ab);
 int ath12k_htc_wait_target(struct ath12k_htc *htc);
 int ath12k_htc_start(struct ath12k_htc *htc);
+void ath12k_htc_poll_ce_all(struct ath12k_base *ab);
+unsigned long ath12k_htc_poll_wait_completion(struct ath12k_base *ab,
+					      struct completion *done,
+					      unsigned long timeout);
 int ath12k_htc_connect_service(struct ath12k_htc *htc,
 			       struct ath12k_htc_svc_conn_req  *conn_req,
 			       struct ath12k_htc_svc_conn_resp *conn_resp);
diff --git a/drivers/net/wireless/ath/ath12k/mac.c b/drivers/net/wireless/ath/ath12k/mac.c
index df4b6a6d9..b7e62186e 100644
--- a/drivers/net/wireless/ath/ath12k/mac.c
+++ b/drivers/net/wireless/ath/ath12k/mac.c
@@ -4134,6 +4134,34 @@ static void ath12k_bss_assoc(struct ath12k *ar,
 		ath12k_warn(ar->ab, "failed to set vdev %i OBSS PD parameters: %d\n",
 			    arvif->vdev_id, ret);
 
+	/*
+	 * TB710FU: the host power-save setting never reaches the firmware on
+	 * this port, so it keeps its own STA power save and the AP delivers
+	 * buffered unicast only in ~2 s bursts.  Turn it off at association
+	 * and pin the related firmware parameters.
+	 */
+	if (of_machine_is_compatible("lenovo,tb710fu") &&
+	    ahvif->vdev_type == WMI_VDEV_TYPE_STA &&
+	    ahvif->vdev_subtype == WMI_VDEV_SUBTYPE_NONE) {
+		ret = ath12k_wmi_pdev_set_ps_mode(ar, arvif->vdev_id,
+						  WMI_STA_PS_MODE_DISABLED);
+		if (ret)
+			ath12k_warn(ar->ab, "failed to disable STA ps vdev %d: %d\n",
+				    arvif->vdev_id, ret);
+
+		ath12k_wmi_set_sta_ps_param(ar, arvif->vdev_id,
+					    WMI_STA_PS_PARAM_INACTIVITY_TIME, 86400);
+		ath12k_wmi_set_sta_ps_param(ar, arvif->vdev_id,
+					    WMI_STA_PS_PARAM_PSPOLL_COUNT,
+					    WMI_STA_PS_PSPOLL_COUNT_NO_MAX);
+		ath12k_wmi_set_sta_ps_param(ar, arvif->vdev_id,
+					    WMI_STA_PS_PARAM_RX_WAKE_POLICY,
+					    WMI_STA_PS_RX_WAKE_POLICY_WAKE);
+		ath12k_wmi_set_sta_ps_param(ar, arvif->vdev_id,
+					    WMI_STA_PS_PARAM_TX_WAKE_THRESHOLD,
+					    WMI_STA_PS_TX_WAKE_THRESHOLD_ALWAYS);
+	}
+
 	if (test_bit(WMI_TLV_SERVICE_11D_OFFLOAD, ar->ab->wmi_ab.svc_map) &&
 	    ahvif->vdev_type == WMI_VDEV_TYPE_STA &&
 	    ahvif->vdev_subtype == WMI_VDEV_SUBTYPE_NONE)
diff --git a/drivers/net/wireless/ath/ath12k/qmi.c b/drivers/net/wireless/ath/ath12k/qmi.c
index 8634935d4..ed8ad0ea7 100644
--- a/drivers/net/wireless/ath/ath12k/qmi.c
+++ b/drivers/net/wireless/ath/ath12k/qmi.c
@@ -3726,7 +3726,11 @@ static int ath12k_qmi_wlanfw_wlan_ini_send(struct ath12k_base *ab)
 	int ret;
 
 	req.enable_fwlog_valid = true;
-	req.enable_fwlog = 1;
+	/*
+	 * TB710FU: the firmware log floods WMI_DIAG events (one per mgmt
+	 * frame during scans), starving WMI and the HTC credits.
+	 */
+	req.enable_fwlog = !of_machine_is_compatible("lenovo,tb710fu");
 
 	ret = qmi_txn_init(&ab->qmi.handle, &txn,
 			   qmi_wlanfw_wlan_ini_resp_msg_v01_ei, &resp);
diff --git a/drivers/net/wireless/ath/ath12k/wifi7/dp_rx.c b/drivers/net/wireless/ath/ath12k/wifi7/dp_rx.c
index 926635319..26dfda3ac 100644
--- a/drivers/net/wireless/ath/ath12k/wifi7/dp_rx.c
+++ b/drivers/net/wireless/ath/ath12k/wifi7/dp_rx.c
@@ -4,6 +4,8 @@
  * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
  */
 
+#include <linux/of.h>
+
 #include "dp_rx.h"
 #include "../dp_peer.h"
 #include "../dp_tx.h"
@@ -394,7 +396,12 @@ static int ath12k_wifi7_dp_rx_h_mpdu(struct ath12k_pdev_dp *dp_pdev,
 		if (rx_info->is_mcbc)
 			rx_status->flag |= RX_FLAG_MIC_STRIPPED |
 					   RX_FLAG_ICV_STRIPPED;
-		else
+		/*
+		 * TB710FU: the IV of group frames is already removed here too;
+		 * without the flags mac80211 parses the SNAP header as the IV.
+		 */
+		if (!rx_info->is_mcbc ||
+		    of_machine_is_compatible("lenovo,tb710fu"))
 			rx_status->flag |= RX_FLAG_IV_STRIPPED |
 					   RX_FLAG_PN_VALIDATED;
 	}
diff --git a/drivers/net/wireless/ath/ath12k/wifi7/dp_tx.c b/drivers/net/wireless/ath/ath12k/wifi7/dp_tx.c
index 587d58eec..68fe37300 100644
--- a/drivers/net/wireless/ath/ath12k/wifi7/dp_tx.c
+++ b/drivers/net/wireless/ath/ath12k/wifi7/dp_tx.c
@@ -4,6 +4,8 @@
  * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
  */
 
+#include <linux/of.h>
+
 #include "../core.h"
 #include "../debug.h"
 #include "../dp_tx.h"
@@ -222,6 +224,18 @@ int ath12k_wifi7_dp_tx(struct ath12k_pdev_dp *dp_pdev, struct ath12k_link_vif *a
 	}
 
 	ti.encap_type = ath12k_dp_tx_get_encap_type(ab, skb);
+
+	/*
+	 * TB710FU: with hardware crypto the encrypt type was never set, so
+	 * protected frames went out unencrypted and the AP dropped them.
+	 */
+	if (of_machine_is_compatible("lenovo,tb710fu") &&
+	    !test_bit(ATH12K_FLAG_HW_CRYPTO_DISABLED, &ab->dev_flags) &&
+	    !(skb_cb->flags & ATH12K_SKB_HW_80211_ENCAP) &&
+	    (skb_cb->flags & ATH12K_SKB_CIPHER_SET)) {
+		ti.encrypt_type = ath12k_dp_tx_get_encrypt_type(skb_cb->cipher);
+		msdu_ext_desc = true;
+	}
 	ti.addr_search_flags = dp_link_vif->hal_addr_search_flags;
 	ti.search_type = dp_link_vif->search_type;
 	ti.type = HAL_TCL_DESC_TYPE_BUFFER;
diff --git a/drivers/net/wireless/ath/ath12k/wmi.c b/drivers/net/wireless/ath/ath12k/wmi.c
index 9493260a4..0b994c9a0 100644
--- a/drivers/net/wireless/ath/ath12k/wmi.c
+++ b/drivers/net/wireless/ath/ath12k/wmi.c
@@ -418,14 +418,36 @@ int ath12k_wmi_cmd_send(struct ath12k_wmi_pdev *wmi, struct sk_buff *skb,
 
 	might_sleep();
 
-	wait_event_timeout(wmi_ab->tx_credits_wq, ({
-		ret = ath12k_wmi_cmd_send_nowait(wmi, skb, cmd_id);
+	/*
+	 * TB710FU: the TX credits only come back through the CE rings, whose
+	 * interrupts do not arrive here; retry and service the rings instead
+	 * of waiting for a wakeup.
+	 */
+	if (of_machine_is_compatible("lenovo,tb710fu")) {
+		unsigned long deadline = jiffies + WMI_SEND_TIMEOUT_HZ;
+
+		do {
+			ret = ath12k_wmi_cmd_send_nowait(wmi, skb, cmd_id);
+
+			if (ret && test_bit(ATH12K_FLAG_CRASH_FLUSH, &wmi_ab->ab->dev_flags))
+				ret = -ESHUTDOWN;
 
-		if (ret && test_bit(ATH12K_FLAG_CRASH_FLUSH, &wmi_ab->ab->dev_flags))
-			ret = -ESHUTDOWN;
+			if (ret != -EAGAIN)
+				break;
+
+			ath12k_htc_poll_ce_all(wmi_ab->ab);
+			usleep_range(1000, 2000);
+		} while (time_before(jiffies, deadline));
+	} else {
+		wait_event_timeout(wmi_ab->tx_credits_wq, ({
+			ret = ath12k_wmi_cmd_send_nowait(wmi, skb, cmd_id);
 
-		(ret != -EAGAIN);
-	}), WMI_SEND_TIMEOUT_HZ);
+			if (ret && test_bit(ATH12K_FLAG_CRASH_FLUSH, &wmi_ab->ab->dev_flags))
+				ret = -ESHUTDOWN;
+
+			(ret != -EAGAIN);
+		}), WMI_SEND_TIMEOUT_HZ);
+	}
 
 	if (ret == -EAGAIN)
 		ath12k_warn(wmi_ab->ab, "wmi command %d timeout\n", cmd_id);
@@ -4365,8 +4387,8 @@ int ath12k_wmi_wait_for_service_ready(struct ath12k_base *ab)
 {
 	unsigned long time_left;
 
-	time_left = wait_for_completion_timeout(&ab->wmi_ab.service_ready,
-						WMI_SERVICE_READY_TIMEOUT_HZ);
+	time_left = ath12k_htc_poll_wait_completion(ab, &ab->wmi_ab.service_ready,
+						    WMI_SERVICE_READY_TIMEOUT_HZ);
 	if (!time_left)
 		return -ETIMEDOUT;
 
@@ -4377,8 +4399,8 @@ int ath12k_wmi_wait_for_unified_ready(struct ath12k_base *ab)
 {
 	unsigned long time_left;
 
-	time_left = wait_for_completion_timeout(&ab->wmi_ab.unified_ready,
-						WMI_SERVICE_READY_TIMEOUT_HZ);
+	time_left = ath12k_htc_poll_wait_completion(ab, &ab->wmi_ab.unified_ready,
+						    WMI_SERVICE_READY_TIMEOUT_HZ);
 	if (!time_left)
 		return -ETIMEDOUT;
 
